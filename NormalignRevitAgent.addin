<?xml version="1.0" encoding="utf-8"?>
<RevitAddIns>
  <AddIn Type="Application">
    <Name>Normalign Agent</Name>
    <!-- Relative path: the DLL is deployed into a subfolder next to this manifest
         by install.ps1, so the same manifest works on any PC / any user. -->
    <Assembly>NormalignRevitAgent\NormalignRevitAgent.dll</Assembly>
    <FullClassName>NormalignRevitAgent.App</FullClassName>
    <ClientId>cd465744-7174-4044-b4e2-69ea01c2a14a</ClientId>
    <VendorId>NRML</VendorId>
    <VendorDescription>Normalign</VendorDescription>
  </AddIn>
</RevitAddIns>
