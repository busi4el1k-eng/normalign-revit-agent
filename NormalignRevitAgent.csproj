<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Revit 2027 runs on .NET 10 (confirmed from its runtimeconfig: "tfm": "net10.0") -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Fixed output folder so the .addin path is always the same, regardless of
         whether you build AnyCPU (CLI) or x64 (Visual Studio). -->
    <OutDir>$(MSBuildProjectDirectory)\bin\</OutDir>
    <AssemblyName>NormalignRevitAgent</AssemblyName>
    <RootNamespace>NormalignRevitAgent</RootNamespace>
  </PropertyGroup>

  <!-- Revit API assemblies. Private=false => do NOT copy them into our output;
       Revit already loads its own copy at runtime. -->
  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>C:\Program Files\Autodesk\Revit 2027\RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>C:\Program Files\Autodesk\Revit 2027\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Copy the manifest next to the DLL after build (handy while developing). -->
  <ItemGroup>
    <None Update="NormalignRevitAgent.addin">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
